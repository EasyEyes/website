BOX_CONFIG=box_config.json
BOX_FOLDER_ID=box_folder_id
BOX_USER_ID=box_user_id
BOX_DEVELOPER_TOKEN=box_developer_token
GLOSSARY_SECRET=your_glossary_secret
PHRASES_SECRET=your_phrases_secret
FIREBASE_DB=your_firebase_db_key
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
DEEPL_API_KEY=your_deepl_api_key_here
# Who may use the media library, by Pavlovia username. A bare name grants
# upload; append :admin to also allow managing entries. Unset means nobody
# uploads, though anyone may still browse and copy links.
MEDIA_ROLES=
# API keys used by the speech token function. Keep these on the server.
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
