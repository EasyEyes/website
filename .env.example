BOX_CONFIG=box_config.json
BOX_FOLDER_ID=box_folder_id
BOX_USER_ID=box_user_id
BOX_DEVELOPER_TOKEN=box_developer_token
GLOSSARY_SECRET=your_glossary_secret
PHRASES_SECRET=your_phrases_secret
FIREBASE_DB=your_firebase_db_key
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
DEEPL_API_KEY=your_deepl_api_key_here
# Who may use the media library, by Pavlovia username. A bare name grants
# upload; append :admin to also allow managing entries. Unset means nobody
# uploads, though anyone may still browse and copy links.
MEDIA_ROLES=
# API keys used by the speech token function. Keep these on the server.
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
# Studio assistant (netlify/functions/studio-assistant). The key stays on the
# server; the browser only ever talks to the function. Model, effort and
# thinking are optional: effort is low|medium|high|xhigh|max (default
# medium) or off for models without it; thinking is adaptive (default — the
# model may think about the ask; its tools take a compact spec, so rounds
# still finish in seconds) or off for the fastest, thought-free rounds.
ANTHROPIC_API_KEY=
STUDIO_ASSISTANT_MODEL=claude-sonnet-5
STUDIO_ASSISTANT_EFFORT=medium
STUDIO_ASSISTANT_THINKING=adaptive
